{
  "name": "news-paper",
  "version": "0.1.0",
  "description": "聚合页纸媒视频模板（对标《AI早报/晚报》版式）— Remotion 实现",
  "main": "src/NewsPaper.tsx",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:light": "remotion render src/index.ts NewsPaper out/demo-light.mp4 --props=examples/light.json",
    "render:dark": "remotion render src/index.ts NewsPaper out/demo-dark.mp4 --props=examples/dark.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.516"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
